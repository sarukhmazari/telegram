{
  "name": "telegram-digital-store-bot",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-ready Telegram Digital Products Store Bot",
  "main": "dist/bot/index.js",
  "scripts": {
    "build": "node node_modules/typescript/lib/tsc.js",
    "start": "node dist/bot/index.js",
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/bot/index.ts",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "prisma:studio": "node node_modules/prisma/build/index.js studio",
    "test": "node node_modules/vitest/vitest.mjs run"
  },
  "keywords": [
    "telegram",
    "bot",
    "digital-store",
    "telegraf",
    "prisma",
    "postgresql",
    "typescript"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "https-proxy-agent": "^9.1.0",
    "telegraf": "^4.16.3",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prisma": "^6.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
