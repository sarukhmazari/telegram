// Prisma Schema for Telegram Digital Products Store Bot

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
  DISABLED
}

enum DeliveryType {
  AUTOMATIC
  MANUAL
  KEY_CODE
  ACCOUNT_CREDENTIALS
  CUSTOM_TEXT
  FILE
}

enum PaymentStatus {
  PENDING
  PAID
  WAITING_FOR_VERIFICATION
  REJECTED
  REFUNDED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PROCESSING
  DELIVERED
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum TransactionType {
  DEPOSIT
  PURCHASE
  REFUND
  ADMIN_CREDIT
  ADMIN_DEBIT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum TicketStatus {
  OPEN
  WAITING
  RESOLVED
  CLOSED
}

enum SenderType {
  USER
  ADMIN
}

enum BroadcastStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  telegramId   BigInt   @unique
  username     String?  @unique
  firstName    String?
  lastName     String?
  balance      Decimal  @default(0.00) @db.Decimal(12, 2)
  role         Role     @default(USER)
  isBanned     Boolean  @default(false)
  referralCode String   @unique @default(uuid())

  referredById String?
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("UserReferrals")

  cart               Cart?
  orders             Order[]
  payments           Payment[]
  walletTransactions WalletTransaction[]
  reviews            Review[]
  supportTickets     SupportTicket[]
  couponUsages       CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([telegramId])
  @@index([username])
  @@index([referralCode])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  position    Int       @default(0)
  isEnabled   Boolean   @default(true)
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([position])
}

model Product {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  imageUrl    String?
  status      ProductStatus @default(ACTIVE)
  isFeatured  Boolean       @default(false)

  variants ProductVariant[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([slug])
}

model ProductVariant {
  id           String       @id @default(uuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  price        Decimal      @db.Decimal(12, 2)
  currency     String       @default("USD")
  duration     String?
  deliveryType DeliveryType @default(AUTOMATIC)
  isEnabled    Boolean      @default(true)

  stockItems StockItem[]
  orderItems OrderItem[]
  cartItems  CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([deliveryType])
}

model StockItem {
  id        String         @id @default(uuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Encrypted stock payload (credentials, key, custom text)
  content String
  fileId  String?

  isSold   Boolean   @default(false)
  orderId  String?
  order    Order?    @relation(fields: [orderId], references: [id])
  lockedAt DateTime?
  soldAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId])
  @@index([isSold])
  @@index([orderId])
}

model Cart {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
}

model Order {
  id             String   @id @default(uuid())
  orderNumber    String   @unique
  idempotencyKey String?  @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id])

  totalAmount    Decimal @db.Decimal(12, 2)
  currency       String  @default("USD")
  discountAmount Decimal @default(0.00) @db.Decimal(12, 2)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  paymentStatus  PaymentStatus  @default(PENDING)
  orderStatus    OrderStatus    @default(PENDING)
  deliveryStatus DeliveryStatus @default(PENDING)
  paymentMethod  String?

  deliveryData   String? // Encrypted JSON payload of delivered goods
  deliveredFileId String?

  items      OrderItem[]
  payments   Payment[]
  stockItems StockItem[]
  review     Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([orderStatus])
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal        @db.Decimal(12, 2)
  totalPrice Decimal       @db.Decimal(12, 2)
}

model Payment {
  id                   String        @id @default(uuid())
  idempotencyKey       String        @unique
  orderId              String
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId               String
  user                 User          @relation(fields: [userId], references: [id])
  amount               Decimal       @db.Decimal(12, 2)
  currency             String
  provider             String
  status               PaymentStatus @default(PENDING)
  transactionReference String?
  proofFileId          String?
  adminNotes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([provider])
}

model WalletTransaction {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Decimal         @db.Decimal(12, 2)
  type         TransactionType
  balanceAfter Decimal         @db.Decimal(12, 2)
  referenceId  String?
  description  String

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Coupon {
  id               String       @id @default(uuid())
  code             String       @unique
  discountType     DiscountType
  discountValue    Decimal      @db.Decimal(12, 2)
  minOrderAmount   Decimal?     @db.Decimal(12, 2)
  maxDiscountAmount Decimal?    @db.Decimal(12, 2)
  expiresAt        DateTime?
  usageLimit       Int?
  usageCount       Int          @default(0)
  perUserLimit     Int          @default(1)
  isEnabled        Boolean      @default(true)

  orders Order[]
  usages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model CouponUsage {
  id       String @id @default(uuid())
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  usedAt DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  isApproved Boolean @default(true)

  createdAt DateTime @default(now())
}

model SupportTicket {
  id           String          @id @default(uuid())
  ticketNumber String          @unique
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  subject      String
  status       TicketStatus    @default(OPEN)
  messages     TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String
  senderType SenderType
  text       String
  fileId     String?

  createdAt DateTime @default(now())
}

model Referral {
  id           String   @id @default(uuid())
  referrerId   String
  referredId   String   @unique
  rewardAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  isRewarded   Boolean  @default(false)

  createdAt DateTime @default(now())
}

model Broadcast {
  id           String          @id @default(uuid())
  adminId      String
  messageText  String
  fileId       String?
  targetCount  Int             @default(0)
  successCount Int             @default(0)
  failCount    Int             @default(0)
  status       BroadcastStatus @default(PENDING)

  createdAt DateTime @default(now())
}

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  details    String?

  createdAt DateTime @default(now())
}
